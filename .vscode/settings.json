{
  "security.workspace.trust.untrustedFiles": "open",
  "actionButtons": {
    "defaultColor": "#ffffff",
    "commands": [
      {
        "name": "$(terminal) Minichlink Debug Terminal",
        "color": "#ffffff",
        "command": "& \"$env:USERPROFILE\\.platformio\\packages\\tool-minichlink\\minichlink.exe\" -T",
        "tooltip": "Click to run Minichlink Terminal"
      }
    ]
  },
  "platformio-ide.toolbar": [
    {
      "text": "$(home)",
      "tooltip": "PlatformIO: Home",
      "commands": "platformio-ide.showHome"
    },
    {
      "text": "$(check)",
      "tooltip": "PlatformIO: Build",
      "commands": "platformio-ide.build"
    },
    {
      "text": "$(arrow-right)",
      "tooltip": "PlatformIO: Upload",
      "commands": "platformio-ide.upload"
    },
    {
      "text": "$(trash)",
      "tooltip": "PlatformIO: Clean",
      "commands": "platformio-ide.clean"
    }
  ]
}